{
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api{,/**}",
        "run": {
          "serviceId": "recipe-cost-backend-dev",
          "region": "us-east5"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
